{
  "expo": {
    "name": "SLC",
    "slug": "loan-calculator",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/loan-calculator.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "SLC uses notifications to remind you about upcoming loan repayments at the times you choose."
      }
    },
    "android": {
      "package": "com.danaa.loancalculator",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/loan-calculator.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/loan-calculator.png"
    },
    "extra": {
      "eas": {
        "projectId": "26d461b5-b66b-4dff-a791-730dfc824d7b"
      }
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/loan-calculator.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2563eb",
          "defaultChannel": "loan-reminders",
          "enableBackgroundRemoteNotifications": false
        }
      ],
      "@react-native-community/datetimepicker"
    ]
  }
}
